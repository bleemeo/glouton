# This file must only use the syntax both sudo.ws and sudo-rs (the default sudo since
# Ubuntu 26.04) understand: sudo-rs prints an error on every sudo call, whoever runs it,
# for each line it doesn't. In particular sudo-rs forbids wildcards in arguments (except
# a final "*" meaning any arguments) and regular expressions, so commands whose arguments
# need such restrictions go through a /usr/lib/glouton/glouton-sudo-* wrapper that checks
# them. The settings only sudo.ws knows are in /etc/sudoers.d/glouton-sudo-ws, installed
# by /usr/lib/glouton/glouton-sudoers-setup when sudo.ws is the active sudo.
# Check both with "visudo.ws -c -f FILE" and "visudo -c -f FILE" (sudo-rs's visudo).

# Allow Glouton to read the MySQL user credentials needed to access the metrics.
glouton     ALL=(root) NOPASSWD: /bin/cat /etc/mysql/debian.cnf

# Allow Glouton to get the container associated to a network interface.
glouton     ALL=(root) NOPASSWD: /usr/lib/glouton/glouton-veths

# Allow Glouton to get the number of banned IPs from fail2ban.
glouton     ALL=(root) NOEXEC: NOPASSWD: /usr/bin/fail2ban-client status, /usr/bin/fail2ban-client status *

# Allow Glouton to read Varnish metrics via varnishstat.
# Note: "-1" is the flag used by the Telegraf varnish input for its metric version 1,
# the one Glouton uses. No other argument is ever passed: a Varnish installed on the
# machine is read without "-n", and a containerised one is read through the container
# runtime rather than through sudo.
glouton     ALL=(root) NOEXEC: NOPASSWD: /usr/bin/varnishstat -1

# Allow Glouton to get SMART metrics.
glouton     ALL=(ALL) NOPASSWD: /usr/bin/smartctl, /usr/sbin/smartctl

# Allow Glouton to read IPMI sensors / DCMI power reading.
glouton     ALL=(ALL) NOPASSWD: /usr/sbin/ipmi-sensors -W discretereading --sdr-cache-recreate, /usr/sbin/ipmi-dcmi --get-enhanced-system-power-statistics, /usr/sbin/ipmi-dcmi --get-system-power-statistics, /usr/bin/ipmitool dcmi power reading

# Allow Glouton to read ssacli output.
# The wrapper only allows read-only commands. Never allow ssacli with free-form arguments:
# it interprets ";" as a command separator, which would give *write* access to the controllers.
glouton     ALL=(ALL) NOPASSWD: /usr/lib/glouton/glouton-sudo-ssacli *

# Allow Glouton to get details about multi-disks arrays.
glouton     ALL=(ALL) NOPASSWD: /sbin/mdadm --detail *, /usr/sbin/mdadm --detail *

# Allow Glouton to read container, application and system logs.
# The wrapper only allows stat and tail on the files Glouton may read.
glouton     ALL=(ALL) NOPASSWD: /usr/lib/glouton/glouton-sudo-logs *

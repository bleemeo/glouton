#!/bin/sh

# This script installs the sudoers settings that only sudo.ws (the original sudo)
# understands, and only when sudo.ws is the active sudo. It must be run as root.
#
# These settings stop sudo from logging each command Glouton runs through it,
# which would otherwise fill auth.log. sudo-rs (the default sudo since Ubuntu 26.04)
# doesn't know them and prints an error on every sudo call, whoever runs it, if they
# are present. So they can't be in /etc/sudoers.d/glouton.
#
# The package runs this script on installation. Run it again after switching
# between sudo.ws and sudo-rs (update-alternatives --config sudo).

PATH=/usr/sbin:/usr/bin:/sbin:/bin

SUDOERS_FILE=/etc/sudoers.d/glouton-sudo-ws

if [ ! -d /etc/sudoers.d ]; then
    exit 0
fi

if ! sudo_version=$(sudo --version 2>/dev/null); then
    # No working sudo, Glouton won't use it.
    rm -f "$SUDOERS_FILE"
    exit 0
fi

case "$sudo_version" in
    *sudo-rs*)
        rm -f "$SUDOERS_FILE"
        exit 0
        ;;
esac

# sudo ignores files whose name contains a ".", so the file isn't used before it's complete.
tmp_file=$(mktemp /etc/sudoers.d/.glouton-sudo-ws.XXXXXX) || exit 1

cat > "$tmp_file" << EOF
# Generated by $0 because sudo.ws is the active sudo.
# Don't edit: sudo-rs doesn't understand these settings, so this file is removed
# when $0 runs while sudo-rs is the active sudo.
Defaults:glouton !logfile, !syslog, !pam_session
EOF

chmod 0440 "$tmp_file"

if command -v visudo > /dev/null && ! visudo -c -q -f "$tmp_file" > /dev/null 2>&1; then
    echo "glouton-sudoers-setup: generated sudoers file is invalid, not installing it" >&2
    rm -f "$tmp_file"
    exit 1
fi

mv -f "$tmp_file" "$SUDOERS_FILE"
